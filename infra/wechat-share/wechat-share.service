[Unit]
Description=WeChat JS-SDK signature service for qinzy.tech
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wechat-share
Group=wechat-share
Environment=AWS_REGION=ap-southeast-1
Environment=WECHAT_APP_ID=wxbd83f6ed93c8184e
Environment=WECHAT_APP_SECRET_PARAMETER=/qinzy/wechat/app-secret
Environment=PORT=8080
ExecStart=/usr/bin/python3 /opt/wechat-share/server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
